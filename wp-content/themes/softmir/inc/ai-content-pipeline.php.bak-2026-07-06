/**
 * Генерация полной карточки ПО через 4-шаговый пайплайн.
 *
 * @param string $url         URL сайта продукта
 * @param string $lang_name   Язык вывода (Russian, Ukrainian, etc.)
 * @param array  $options     [
 *   'attrs_prompt'     => string,  // промпт атрибутов категории
 *   'cat_funcs_prompt' => string,  // промпт функций категории
 *   'post_title'       => string,  // для логов
 * ]
 * @return array|WP_Error     JSON-данные карточки
 */
function softmir_run_content_pipeline(string $url, string $lang_name = 'Russian', array $options = []): array|WP_Error {
    $attrs_prompt     = $options['attrs_prompt'] ?? '';
    $cat_funcs_prompt = $options['cat_funcs_prompt'] ?? '';
    $post_title       = $options['post_title'] ?? $url;
    $quality_rules    = softmir_get_quality_rules();
    $json_schema      = softmir_get_json_schema();

    // ─── STEP 1: АНАЛИТИК ───────────────────────────────────────────
    if (function_exists('softmir_log_ai_action')) {
        softmir_log_ai_action("🕵️ Агент 1 (Аналитик): Сбор фактуры для '{$post_title}'...");
    }

    $step1_prompt = "РОЛЬ: Ты - Senior Product Analyst & Data Miner.\n"
        . "ЦЕЛЬ: Проанализируй контент сайта ({$url}) и извлеки 100% специфицированную фактуру без 'воды'.\n\n"
        . "ИСТОЧНИК ДАННЫХ: Используй Google Search для получения РЕАЛЬНОЙ информации с {$url}. "
        . "Обязательно найди /pricing, /features, /integrations, /about и реальные отзывы.\n\n"
        . "ПРАВИЛА:\n"
        . "1. Если сайт недоступен (Cloudflare, 403, 525, Captcha) — поставь \"scraping_failed\": true.\n"
        . "2. Определи, является ли {$url} реферальной ссылкой (?ref=, aff=, partner). Если да — \"is_referral\": true.\n"
        . "3. ТОЛЬКО конкретика (названия модулей, числа, реальные интеграции). НИКАКОЙ абстракции.\n"
        . "{$quality_rules}\n"
        . "ИНТЕРНЕТ-ПОИСК (ВАЖНО): Для external_reviews, price_summary и disadvantages ОБЯЗАТЕЛЬНО используй Google Search.\n"
        . "SEO:\n"
        . "   - ЗАПРЕЩЕНО 'Цены', '2024', 'Отзывы' в заголовках.\n"
        . "   - focus_keyword: [Название продукта].\n"
        . "   - rank_math_title: '[Продукт]: Обзор [Категория] ([Выгода])' (50-60 символов).\n"
        . "   - rank_math_description: 140-160 символов, продающее описание с CTA.\n"
        . "   - rank_math_permalink: КОРОТКИЙ slug латиницей, макс 2 слова.\n"
        . "УНИКАЛЬНОСТЬ short_description: НЕ дублировать блок 'Почему SoftZor рекомендует' из full_description.\n\n"
        . "СТРОГИЕ ПРАВИЛА ДЛЯ РЫНКА УКРАИНЫ:\n"
        . "1. Исключай софт RU/BY происхождения (под санкциями).\n"
        . "2. Цены ТОЛЬКО в USD, EUR или UAH.\n"
        . "3. ВЕСЬ текст на языке: {$lang_name}!\n"
        . "5. category_key_functions — ВЫБИРАЙ СТРОГО из 'РЕЙТИНГ ФУНКЦИЙ', не выдумывай.\n\n"
        . ($attrs_prompt ? "АТРИБУТЫ:\n{$attrs_prompt}\n" : '')
        . ($cat_funcs_prompt ? "КАТЕГОРИИ ФУНКЦИЙ:\n{$cat_funcs_prompt}\n" : '')
        . "Язык: {$lang_name}\n\n"
        . "ОТВЕТ — СТРОГО JSON:\n{$json_schema}";

    $res1 = softmir_pipeline_gemini_call($step1_prompt, ['temperature' => 0.1]);
    if (is_wp_error($res1)) return $res1;

    $ai_json = json_decode(trim(preg_replace('/^```json\s*|\s*```$/i', '', $res1['text'])), true);
    if (!is_array($ai_json)) {
        return new WP_Error('invalid_json', 'Step 1: Invalid JSON. Raw: ' . substr($res1['text'], 0, 300));
    }

    if (!empty($ai_json['scraping_failed'])) {
        if (function_exists('softmir_log_ai_action')) {
            softmir_log_ai_action("🚫 Сайт '{$url}' недоступен. Генерация прервана.");
        }
        return new WP_Error('scraping_failed', "Сайт {$url} недоступен (Cloudflare/403/525).");
    }

    // ─── STEP 2: КОПИРАЙТЕР ─────────────────────────────────────────
    if (function_exists('softmir_log_ai_action')) {
        softmir_log_ai_action("✍️ Агент 2 (Копирайтер): Генерация HTML для '{$post_title}'...");
    }

    $seo_strat = json_encode($ai_json['seo_strategy'] ?? [], JSON_UNESCAPED_UNICODE);
    $factura = json_encode([
        'features'      => $ai_json['features'] ?? [],
        'integrations'  => $ai_json['integrations'] ?? [],
        'price'         => $ai_json['price_summary'] ?? '',
        'advantages'    => $ai_json['advantages'] ?? [],
        'disadvantages' => $ai_json['disadvantages'] ?? [],
        'real_reviews'  => $ai_json['external_reviews'] ?? [],
    ], JSON_UNESCAPED_UNICODE);

    $step2_prompt = "РОЛЬ: Экспертный B2B Копирайтер (уровня Максима Ильяхова).\n"
        . "ЦЕЛЬ: Написать блок 'Полное описание' продукта в строгом HTML.\n\n"
        . "=== СТРАТЕГИЯ (от Аналитика) ===\n{$seo_strat}\n"
        . "=== ФАКТЫ ===\n{$factura}\n\n"
        . "ПРАВИЛА: Рваный ритм. Язык пользы. Реальные термины из фактуры. Язык: {$lang_name}.\n"
        . "ЗАПРЕЩЕНО: 'швейцарский нож', 'незаменимый помощник', 'единое окно', 'всё в одном месте'.\n"
        . "Блок 'Почему SoftZor рекомендует' НЕ дублирует short_description.\n\n"
        . "ФОРМАТ (ТОЛЬКО HTML, без markdown/JSON):\n"
        . "<p>🟢 <b>Релевантность: [85-99]% ([Вердикт])</b><br><b>Почему SoftZor рекомендует:</b> «[2 строчки]».</p>\n"
        . "<p>⚡ <b>[Название]: [Суть]</b><br>[1-2 предложения].</p>\n"
        . "<h3>⚙️ Главные функции</h3>\n<ul><li>[Смайл] <b>[Функция]</b> ➔ [Польза]</li></ul>\n"
        . "<h3>📊 Сложность внедрения</h3>\n<p><b>Порог входа:</b> [Описание].<br><b>Интерфейс:</b> [Описание].<br><b>Для кого:</b> [Профиль].<br><b>С кем дружит:</b> [Интеграции].</p>\n"
        . "<h3>🌐 Плюсы и минусы</h3>\n<p>👍 <b>Что хвалят:</b> [Резюме].<br>👎 <b>Слабые стороны:</b> [Резюме].</p>\n"
        . "<h3>💰 Цены и тарифы</h3>\n"
        . "<p><b>Модель оплаты:</b> [Описание. Если цен нет — 'С тарифами ознакомьтесь на <a href=\"{$url}\" target=\"_blank\">официальном сайте</a>'].<br>"
        . "<b>Стоимость:</b> [Рамки цен, если известны].</p>";

    $res2 = softmir_pipeline_gemini_call($step2_prompt, ['temperature' => 0.4, 'use_search' => true]);
    $draft_html = is_wp_error($res2) ? '' : trim($res2['text']);

    // ─── STEP 3: РЕДАКТОР ───────────────────────────────────────────
    if (!empty($draft_html)) {
        if (function_exists('softmir_log_ai_action')) {
            softmir_log_ai_action("🧐 Агент 3 (Редактор): Отжим воды для '{$post_title}'...");
        }

        $step3_prompt = "РОЛЬ: Строгий Главный Редактор.\n"
            . "ЦЕЛЬ: Очистить HTML от штампов, клише, воды, канцеляризмов. Оставить мясо и пользу.\n\n"
            . "Чек-лист:\n"
            . "1. Удали 'в современном мире', 'инновационное решение', 'уникальный продукт'.\n"
            . "2. Удали 'швейцарский нож', 'единое окно', 'всё в одном месте'. Замени конкретикой.\n"
            . "3. Оценочные прилагательные без доказательств → замени фактами.\n"
            . "4. Проверь целостность HTML (p, h3, ul, li, b). Удали ```html.\n"
            . "5. 'Почему SoftZor рекомендует этот продукт:' ОБЯЗАТЕЛЬНО в <b>.\n"
            . "6. Язык: {$lang_name}\n\n"
            . "Текст:\n{$draft_html}\n\n"
            . "ВЕРНИ ТОЛЬКО ОЧИЩЕННЫЙ HTML.";

        $res3 = softmir_pipeline_gemini_call($step3_prompt, ['temperature' => 0.1, 'timeout' => 60]);
        if (!is_wp_error($res3)) {
            $clean = preg_replace('/^```html\s*|\s*```$/i', '', trim($res3['text']));
            if (!empty($clean)) $draft_html = $clean;
        }
    }

    $ai_json['full_description'] = $draft_html;

    // ─── STEP 4: КРИТИК (QA) ────────────────────────────────────────
    if (function_exists('softmir_log_ai_action')) {
        softmir_log_ai_action("🔍 Агент 4 (Критик): Проверка качества для '{$post_title}'...");
    }

    $qa_result = softmir_pipeline_qa_check($ai_json);
    if (!is_wp_error($qa_result)) {
        $score = intval($qa_result['score'] ?? 0);
        $feedback = $qa_result['feedback'] ?? '';
        if (function_exists('softmir_log_ai_action')) {
            softmir_log_ai_action("📊 QA Score: {$score}/10 — {$feedback}");
        }
        $ai_json['_qa_score'] = $score;
        $ai_json['_qa_feedback'] = $feedback;

        // Если критик дал < 6, перегенерируем Step 2-3 с обратной связью
        if ($score < 6 && !empty($factura)) {
            if (function_exists('softmir_log_ai_action')) {
                softmir_log_ai_action("🔄 Перегенерация: QA дал {$score}/10. Причина: {$feedback}");
            }
            $retry_prompt = $step2_prompt . "\n\nОБРАТНАЯ СВЯЗЬ ОТ QA (ИСПРАВЬ!):\n{$feedback}";
            $res2r = softmir_pipeline_gemini_call($retry_prompt, ['temperature' => 0.3, 'use_search' => true]);
            if (!is_wp_error($res2r)) {
                $retry_html = preg_replace('/^```html\s*|\s*```$/i', '', trim($res2r['text']));
                if (!empty($retry_html)) {
                    $ai_json['full_description'] = $retry_html;
                    $ai_json['_qa_score'] = $score . ' → retry';
                }
            }
        }
    }

    unset($ai_json['seo_strategy']); // Cleanup
    return $ai_json;
}

/* ========================================================================
 * 5. QA-КРИТИК (проверка качества)
 * ======================================================================== */

function softmir_pipeline_qa_check(array $ai_data): array|WP_Error {
    $json_payload = wp_json_encode($ai_data, JSON_UNESCAPED_UNICODE);
    $quality_rules = softmir_get_quality_rules();

    $prompt = "РОЛЬ: Строгий QA-инженер и редактор B2B-контента.\n\n"
        . "ЗАДАЧА: Проверь качество карточки ПО. Оцени по этим правилам:\n{$quality_rules}\n\n"
        . "ДАННЫЕ:\n{$json_payload}\n\n"
        . "ФОРМАТ: Строго JSON с полями:\n"
        . "- 'score': число 1-10 (10 = идеально)\n"
        . "- 'feedback': 1-2 предложения с конкретными замечаниями\n";

    $res = softmir_pipeline_gemini_call($prompt, [
        'temperature'   => 0.1,
        'timeout'       => 30,
        'use_search'    => false,
        'response_mime' => 'application/json',
    ]);

    if (is_wp_error($res)) return $res;

    $raw = str_replace(['```json', '```'], '', trim($res['text']));
    $result = json_decode(trim($raw), true);

    if (isset($result['score'], $result['feedback'])) {
        return $result;
    }
    return new WP_Error('qa_parse', 'Cannot parse QA JSON');
}
